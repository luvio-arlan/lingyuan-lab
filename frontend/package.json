{
  "name": "lingyuan-lab-frontend",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "brand": "node scripts/prepare-brand.mjs",
    "fonts": "node scripts/prepare-fonts.mjs",
    "dev": "npm run brand && npm run fonts && astro dev",
    "build": "npm run brand && npm run fonts && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:links": "node scripts/check-links.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "test:links": "node --test scripts/check-links.test.mjs",
    "test:contrast": "node --test scripts/check-contrast.test.mjs",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-serif-sc": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "astro": "^7.3.5",
    "gsap": "^3.15.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "typescript": "^5.9.3"
  }
}
