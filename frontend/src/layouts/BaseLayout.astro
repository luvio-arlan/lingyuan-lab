---
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/noto-serif-sc/wght.css';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource-variable/geist-mono/wght.css';
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  bodyClass?: string;
  footer?: boolean;
}

const { title, description = site.description, bodyClass, footer = true } = Astro.props;
const fullTitle = title ? `${title} · ${site.nameZh}` : `${site.nameZh} · ${site.name}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL('/og-image.png', Astro.site);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Lingyuan Lab · AI × Organization Research" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">跳到正文</a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    {footer && <SiteFooter />}
    <script>
      import '../scripts/core.ts';
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    top: 12px;
    left: 12px;
    z-index: 200;
    padding: 0.6rem 1rem;
    border-radius: var(--r-pill);
    background: var(--c-ink);
    color: #fff;
    font-size: var(--t-small);
    transform: translateY(-160%);
    transition: transform var(--d-base) var(--ease-out);
  }

  .skip-link:focus {
    transform: none;
  }
</style>
