---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import { lessonBySlug, lessons } from '../../data/path';
import { contentStatus } from '../../data/site';

const lessonOrder = (slug: string) => lessons.findIndex((l) => l.slug === slug);
const tools = (await getCollection('tools')).sort((a, b) => lessonOrder(a.data.lesson) - lessonOrder(b.data.lesson));
---

<BaseLayout title="工具箱" description="与首发文章对应、可打印或复制的分析表。">
  <PageHero
    eyebrow="工具箱 · Tools"
    title={'把概念，\n带回你的团队。'}
    lead="每份工具都对应一课内容。你可以在线填写（答案只保存在你的浏览器里），也可以打印成纸质版，或复制为 Markdown 分享。"
    accent="teal"
  />

  <section class="container grid">
    {
      tools.map((t, i) => {
        const lesson = lessonBySlug(t.data.lesson);
        const items = t.data.sections.reduce((n, s) => n + s.items.length, 0);
        return (
          <a class="card spotlight tool" href={`/tools/${t.id}`} data-accent={t.data.accent} data-reveal style={`--i:${i}`}>
            <div class="preview" aria-hidden="true">
              <div class="paper">
                <span class="p-k mono">{t.data.format.toUpperCase()}</span>
                <span class="p-t">{t.data.title}</span>
                {t.data.sections.slice(0, 4).map((s, si) => (
                  <span class="p-row" style={`--i:${si}`}>
                    <span class="p-n mono">{String(si + 1).padStart(2, '0')}</span>
                    <span class="p-l">{s.title}</span>
                  </span>
                ))}
              </div>
            </div>
            <div class="copy">
              <div class="chips">
                <span class="chip">
                  <Icon name="clipboard" size={14} />
                  {t.data.format}
                </span>
                {lesson && <span class="chip chip-outline">第 {lesson.no} 课</span>}
              </div>
              <h2 class="h2">{t.data.title}</h2>
              <p>{t.data.summary}</p>
              <dl class="facts">
                <div>
                  <dt>题目</dt>
                  <dd class="mono">{items}</dd>
                </div>
                <div>
                  <dt>用时</dt>
                  <dd class="mono">~{t.data.minutes} min</dd>
                </div>
                <div>
                  <dt>状态</dt>
                  <dd>{contentStatus[t.data.status].label}</dd>
                </div>
              </dl>
              <span class="link-arrow">
                打开工具 <Icon name="arrow-right" />
              </span>
            </div>
          </a>
        );
      })
    }
  </section>
</BaseLayout>

<style>
  .grid {
    display: grid;
    gap: 1.5rem;
  }

  .tool {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    overflow: hidden;
    border-radius: var(--r-xl);
  }

  .preview {
    display: grid;
    place-items: end center;
    padding: 2.5rem 2.5rem 0;
    background:
      radial-gradient(80% 80% at 50% 100%, var(--a-soft), transparent 70%),
      var(--c-mist);
    border-right: 1px solid var(--c-line);
  }

  .paper {
    display: grid;
    gap: 0.6rem;
    width: min(100%, 340px);
    padding: 1.5rem 1.5rem 2rem;
    border-radius: 14px 14px 0 0;
    background: var(--c-bg);
    box-shadow:
      0 0 0 1px var(--c-line) inset,
      var(--shadow-3);
    transform: translateY(16px) rotate(-1.5deg);
    transition: transform 900ms var(--ease-spring);
  }

  .tool:hover .paper {
    transform: translateY(0) rotate(0);
  }

  .p-k {
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    color: var(--a-ink);
  }

  .p-t {
    margin-bottom: 0.5rem;
    font-family: var(--f-display);
    font-weight: 600;
    font-size: 1.125rem;
  }

  .p-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 0.7rem;
    border-radius: 8px;
    background: var(--c-mist);
    font-size: 0.8125rem;
    color: var(--c-ink-2);
    transition: transform 600ms var(--ease-out);
    transition-delay: calc(var(--i) * 50ms);
  }

  .tool:hover .p-row {
    transform: translateX(4px);
  }

  .p-n {
    font-size: 0.6875rem;
    color: var(--a-ink);
  }

  .copy {
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 1rem;
    padding: clamp(1.75rem, 1rem + 3vw, 3.5rem);
  }

  .chips {
    display: flex;
    gap: 0.5rem;
  }

  .copy p {
    max-width: 32rem;
    color: var(--c-ink-3);
    line-height: 1.8;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    margin: 0.5rem 0;
  }

  .facts dt {
    font-size: 0.75rem;
    color: var(--c-ink-4);
  }

  .facts dd {
    margin: 0.2rem 0 0;
    font-size: 0.875rem;
    font-weight: 550;
  }

  @media (max-width: 820px) {
    .tool {
      grid-template-columns: 1fr;
    }
    .preview {
      border-right: 0;
      border-bottom: 1px solid var(--c-line);
    }
  }
</style>
