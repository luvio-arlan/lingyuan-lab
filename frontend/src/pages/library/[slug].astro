---
import { getCollection, getEntries, getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import TermCard from '../../components/TermCard.astro';
import Claim from '../../components/mdx/Claim.astro';
import KeyIdea from '../../components/mdx/KeyIdea.astro';
import OdCycle from '../../components/diagrams/OdCycle.astro';
import StarModel from '../../components/diagrams/StarModel.astro';
import WorkLayers from '../../components/diagrams/WorkLayers.astro';
import ChangeLayers from '../../components/diagrams/ChangeLayers.astro';
import AgentHandoff from '../../components/diagrams/AgentHandoff.astro';
import DecisionRights from '../../components/diagrams/DecisionRights.astro';
import TeamChoices from '../../components/diagrams/TeamChoices.astro';
import TalentLoop from '../../components/diagrams/TalentLoop.astro';
import { articleStatus, evidenceTypes } from '../../data/site';
import { lessonBySlug } from '../../data/path';
import { formatDate, isoDate, readingMinutes } from '../../lib/format';
import '../../styles/prose.css';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}

const { article } = Astro.props;
const { data } = article;
const { Content, headings } = await render(article);
const toc = headings.filter((h) => h.depth === 2);
const terms = await getEntries(data.terms);
const tool = data.tool ? await getEntry(data.tool) : undefined;
const discussion = data.discussion ? await getEntry(data.discussion) : undefined;
const lesson = data.lesson ? lessonBySlug(data.lesson) : undefined;
const status = articleStatus(data.status, data.sources);
const minutes = readingMinutes(article.body);
const pending = data.sources.filter((s) => !s.verified).length;
---

<BaseLayout title={data.title} description={data.dek}>
  <div class="progress" aria-hidden="true"><span data-progress></span></div>

  <article class="article" data-accent={data.accent}>
    <header class="head container">
      <nav class="crumbs" aria-label="面包屑">
        <a href="/library">知识库</a>
        {
          lesson && (
            <>
              <span aria-hidden="true">/</span>
              {lesson.status === 'available' ? (
                <a href={`/learn/${lesson.slug}`}>第 {lesson.no} 课</a>
              ) : (
                <span>第 {lesson.no} 课 · 筹备中</span>
              )}
            </>
          )
        }
        <span aria-hidden="true">/</span>
        <span aria-current="page">{lesson ? '课程正文' : data.kind === 'concept' ? '知识解读' : '研究文章'}</span>
      </nav>
      <h1 class="display title" style={`view-transition-name: article-${article.id}`}>{data.title}</h1>
      <p class="dek lead">{data.dek}</p>

      <dl class="meta">
        <div>
          <dt>{data.status === 'draft' ? '草稿建立' : '发布'}</dt>
          <dd class="mono"><time datetime={isoDate(data.published)}>{formatDate(data.published)}</time></dd>
        </div>
        <div>
          <dt>最近修订</dt>
          <dd class="mono"><time datetime={isoDate(data.revised)}>{formatDate(data.revised)}</time></dd>
        </div>
        <div>
          <dt>阅读</dt>
          <dd>约 {minutes} 分钟</dd>
        </div>
        <div>
          <dt>内容状态</dt>
          <dd class="status" data-accent={status.accent}><span class="dot"></span>{status.label}</dd>
        </div>
      </dl>

      <div class="frame">
        <div>
          <p class="frame-k mono">研究问题</p>
          <p class="frame-v">{data.question}</p>
        </div>
        <div>
          <p class="frame-k mono">适用边界</p>
          <p class="frame-v small">{data.scope}</p>
        </div>
      </div>
    </header>

    <div class="body container">
      <aside class="rail">
        <div class="rail-inner">
          {
            toc.length > 0 && (
              <nav class="toc" aria-label="文章目录" data-toc>
                <p class="rail-k mono">目录</p>
                <ol role="list">
                  {toc.map((h, i) => (
                    <li>
                      <a href={`#${h.slug}`} data-toc-link={h.slug}>
                        <span class="mono">{String(i + 1).padStart(2, '0')}</span>
                        {h.text}
                      </a>
                    </li>
                  ))}
                </ol>
              </nav>
            )
          }
        </div>
      </aside>

      <div class="prose" data-prose>
        <Content components={{ Claim, KeyIdea, OdCycle, StarModel, WorkLayers, ChangeLayers, AgentHandoff, DecisionRights, TeamChoices, TalentLoop }} />
      </div>

      <aside class="reading-notes" aria-labelledby="evidence-legend-title">
        <div class="rail-inner">
          <div class="legend">
            <h2 class="rail-k mono" id="evidence-legend-title">证据标注</h2>
            <ul role="list">
              {
                Object.entries(evidenceTypes).map(([key, t]) => (
                  <li data-accent={t.accent} data-type={key} title={t.note}>
                    <span class="bar" />
                    <div>
                      <p class="legend-name">{t.label}</p>
                      <p class="legend-note">{t.note}</p>
                    </div>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </aside>
    </div>

    <footer class="after container">
      <section class="block" aria-labelledby="sources-title">
        <div class="block-head">
          <h2 class="h3" id="sources-title">来源</h2>
          {
            pending > 0 && (
              <p class="note">
                <Icon name="info" size={16} />
                {pending} 条来源尚待人工逐条核对，核对完成前请以原始文献为准。
              </p>
            )
          }
        </div>
        <ol class="sources" role="list">
          {
            data.sources.map((s, i) => (
              <li id={`source-${i + 1}`}>
                <span class="n mono">{i + 1}</span>
                <div>
                  <p class="s-title">
                    {s.authors}（{s.year}）. <cite>{s.title}</cite>
                    {s.edition && <>, {s.edition}</>}
                    {s.venue && <>. {s.venue}</>}
                  </p>
                  <p class="s-meta">
                    <span class:list={['v', s.verified ? 'ok' : 'todo']}>
                      {s.verified ? '已核对' : '待核对'}
                    </span>
                    {s.doi && <span class="mono">DOI {s.doi}</span>}
                    {s.note && <span>{s.note}</span>}
                    {s.url && (
                      <a href={s.url} rel="noopener noreferrer" target="_blank">
                        查看来源 <Icon name="arrow-up-right" size={14} />
                      </a>
                    )}
                  </p>
                </div>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="block" aria-labelledby="rev-title">
        <h2 class="h3" id="rev-title">修订记录</h2>
        <ol class="revs" role="list">
          {
            data.revisions.map((r) => (
              <li>
                <time class="mono" datetime={isoDate(r.date)}>{formatDate(r.date)}</time>
                <span>{r.note}</span>
              </li>
            ))
          }
        </ol>
      </section>

      {
        terms.length > 0 && (
          <section class="block" aria-labelledby="terms-title">
            <h2 class="h3" id="terms-title">本文术语</h2>
            <div class="terms">
              {terms.map((t, i) => (
                <TermCard term={t} index={i} compact />
              ))}
            </div>
          </section>
        )
      }

      <section class="block next" aria-labelledby="next-title">
        <h2 class="h3" id="next-title">下一步</h2>
        <div class="next-grid">
          {
            tool && (
              <a class="card spotlight next-card" href={`/tools/${tool.id}`} data-accent="teal" data-reveal>
                <span class="chip">
                  <Icon name="clipboard" size={14} />
                  完成一份练习
                </span>
                <h3 class="h3">{tool.data.title}</h3>
                <p>{tool.data.summary}</p>
                <span class="link-arrow">
                  打开工具 <Icon name="arrow-right" />
                </span>
              </a>
            )
          }
          {
            discussion && (
              <a
                class="card spotlight next-card"
                href={`/questions/${discussion.id}`}
                data-accent="orange"
                data-reveal
                style="--i:1"
              >
                <span class="chip">
                  <Icon name="message" size={14} />
                  提出一个观点
                </span>
                <h3 class="h3">{discussion.data.title}</h3>
                <span class="link-arrow">
                  参与讨论 <Icon name="arrow-right" />
                </span>
              </a>
            )
          }
        </div>
      </section>
    </footer>
  </article>
</BaseLayout>

<style>
  .progress {
    position: fixed;
    inset: 0 0 auto;
    z-index: 120;
    height: 2px;
    pointer-events: none;
  }

  .progress span {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, var(--c-blue), var(--c-violet), var(--c-teal));
    transform-origin: left;
    transform: scaleX(var(--p, 0));
  }

  .article {
    --reader-rail: 12rem;
    --reader-gap: clamp(1.5rem, 3vw, 3rem);
    --reader-notes: 14rem;
  }

  .body,
  .after {
    display: grid;
    grid-template-columns: var(--reader-rail) minmax(0, 1fr) var(--reader-notes);
    column-gap: var(--reader-gap);
    max-width: var(--max);
  }

  .after > * {
    grid-column: 2;
    min-width: 0;
  }

  .head {
    display: grid;
    gap: clamp(1.5rem, 2.5vw, 2.5rem);
    max-width: var(--max);
    padding-top: calc(var(--header-h) + clamp(3rem, 5vw, 5rem));
  }

  .head > * {
    min-width: 0;
  }

  .crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.6rem;
    font-size: var(--t-small);
    color: var(--c-ink-3);
    animation: fade 0.8s var(--ease-out) both;
  }

  .crumbs a {
    color: var(--c-ink-2);
    padding-block: 0.35rem;
    text-decoration: underline;
    text-decoration-color: var(--c-line-3);
    text-underline-offset: 0.25em;
    transition: color var(--d-fast) var(--ease-out);
  }

  .crumbs a:hover {
    color: var(--a-ink);
  }

  .title {
    font-size: var(--t-h1);
    line-height: 1.3;
  }

  .dek {
    max-width: 56rem;
    font-size: var(--t-lead);
    animation: fade 1s 0.15s var(--ease-out) both;
  }

  .meta {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem 2rem;
    margin: 0;
    padding: 1.5rem 0;
    border-block: 1px solid var(--c-line);
    animation: fade 1s 0.25s var(--ease-out) both;
  }

  .meta dt {
    font-size: 0.75rem;
    color: var(--c-ink-4);
  }

  .meta dd {
    margin: 0.2rem 0 0;
    font-size: 0.875rem;
    font-weight: 550;
    color: var(--c-ink);
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--a-ink) !important;
  }

  .status .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--a);
    box-shadow: 0 0 0 4px var(--a-soft);
  }

  .frame {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    overflow: hidden;
    border-radius: var(--r-lg);
    background: var(--c-line);
    box-shadow: 0 0 0 1px var(--c-line);
    animation: fade 1s 0.35s var(--ease-out) both;
  }

  .frame > div {
    padding: clamp(1.25rem, 2.5vw, 2rem);
    background: var(--c-mist);
  }

  .frame > div:first-child {
    background: linear-gradient(135deg, var(--a-soft), var(--c-mist));
  }

  .frame-k {
    margin-bottom: 0.4rem;
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    color: var(--a-ink);
  }

  .frame-v {
    font-family: var(--f-display);
    font-weight: 500;
    font-size: var(--t-lead);
    line-height: 1.7;
    color: var(--c-ink);
  }

  .frame-v.small {
    font-family: var(--f-sans);
    font-size: 0.9375rem;
    font-weight: 400;
    color: var(--c-ink-2);
    line-height: 1.75;
  }

  @keyframes fade {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  /* Body */
  .body {
    align-items: start;
    margin-top: clamp(3rem, 4vw, 4rem);
  }

  .body > .prose {
    min-width: 0;
  }

  .body > .prose > :global(:first-child) {
    margin-top: 0;
  }

  .rail,
  .reading-notes {
    align-self: stretch;
    min-width: 0;
  }

  .rail-inner {
    position: sticky;
    top: calc(var(--header-h) + 2rem);
    display: grid;
    gap: 2rem;
    max-height: calc(100dvh - var(--header-h) - 4rem);
    overflow-y: auto;
    scrollbar-width: thin;
    padding-right: 0.5rem;
  }

  .rail-k {
    margin-bottom: 0.9rem;
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    color: var(--c-ink-4);
  }

  .toc ol {
    position: relative;
    display: grid;
    margin: 0;
    border-left: 1px solid var(--c-line-2);
  }

  .toc a {
    position: relative;
    display: flex;
    gap: 0.6rem;
    padding: 0.45rem 0 0.45rem 1rem;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--c-ink-3);
    transition: color var(--d-base) var(--ease-out);
  }

  .toc a .mono {
    font-size: 0.6875rem;
    padding-top: 0.15em;
    color: var(--c-ink-4);
  }

  .toc a::before {
    content: '';
    position: absolute;
    left: -1px;
    top: 0.4rem;
    bottom: 0.4rem;
    width: 2px;
    border-radius: 2px;
    background: var(--a);
    transform: scaleY(0);
    transition: transform 400ms var(--ease-spring);
  }

  .toc a:hover {
    color: var(--c-ink);
  }

  .toc a.is-active {
    color: var(--c-ink);
    font-weight: 550;
  }

  .toc a.is-active .mono {
    color: var(--a-ink);
  }

  .toc a.is-active::before {
    transform: scaleY(1);
  }

  .legend ul {
    display: grid;
    gap: 1.25rem;
    margin: 0;
  }

  .legend li {
    display: flex;
    align-items: start;
    gap: 0.75rem;
    font-size: var(--t-small);
    color: var(--c-ink-2);
  }

  .legend-name {
    margin-bottom: 0.35rem;
    font-weight: 550;
  }

  .legend-note {
    font-size: var(--t-micro);
    line-height: 1.75;
    color: var(--c-ink-3);
  }

  .legend .bar {
    flex: none;
    width: 2px;
    height: 14px;
    margin-top: 0.2rem;
    border-radius: 2px;
    background: var(--a);
  }

  .legend [data-type='inference'] .bar {
    background: repeating-linear-gradient(to bottom, var(--a) 0 4px, transparent 4px 6px);
  }

  .legend [data-type='hypothesis'] .bar {
    background: repeating-linear-gradient(to bottom, var(--a) 0 2px, transparent 2px 4px);
  }

  /* After */
  .after {
    row-gap: clamp(3rem, 2rem + 3vw, 4.5rem);
    margin-top: clamp(4rem, 3rem + 4vw, 7rem);
  }

  .after > .block:first-child {
    padding-top: 2rem;
    border-top: 1px solid var(--c-line-2);
  }

  .block {
    display: grid;
    gap: 1.5rem;
  }

  .block-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .note {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.85rem;
    border-radius: var(--r-pill);
    background: var(--c-orange-soft);
    font-size: 0.8125rem;
    color: var(--c-orange-ink);
  }

  .sources {
    display: grid;
    margin: 0;
    overflow-wrap: anywhere;
  }

  .sources li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 0.5rem;
    padding: 1.1rem 0;
    border-top: 1px solid var(--c-line);
    scroll-margin-top: calc(var(--header-h) + 40px);
    transition: background-color 600ms var(--ease-out);
  }

  .sources li:target {
    background: var(--c-blue-soft);
    border-radius: var(--r-sm);
  }

  .sources .n {
    font-size: 0.8125rem;
    color: var(--c-blue-ink);
    padding: 0.1rem 0 0 0.5rem;
  }

  .s-title {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--c-ink);
  }

  .s-title cite {
    font-style: italic;
  }

  .s-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 1rem;
    margin-top: 0.4rem;
    font-size: 0.75rem;
    color: var(--c-ink-3);
  }

  .s-meta a {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    color: var(--c-blue-ink);
    font-weight: 550;
  }

  .v {
    padding: 0.1rem 0.5rem;
    border-radius: var(--r-pill);
    font-weight: 600;
  }

  .v.todo {
    background: var(--c-orange-soft);
    color: var(--c-orange-ink);
  }

  .v.ok {
    background: var(--c-teal-soft);
    color: var(--c-teal-ink);
  }

  .revs {
    display: grid;
    gap: 0.75rem;
    margin: 0;
  }

  .revs li {
    display: flex;
    gap: 1.25rem;
    font-size: 0.9375rem;
    color: var(--c-ink-2);
  }

  .revs time {
    font-size: 0.8125rem;
    color: var(--c-ink-3);
    padding-top: 0.1rem;
  }

  .terms {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1rem;
  }

  .next-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .next-card {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 0.85rem;
    padding: 1.75rem;
  }

  .next-card p {
    color: var(--c-ink-3);
    font-size: 0.9375rem;
    line-height: 1.75;
  }

  .next-card .link-arrow {
    margin-top: auto;
  }

  @media (max-width: 1200px) {
    .body,
    .after {
      grid-template-columns: var(--reader-rail) minmax(0, 1fr);
    }
    .reading-notes {
      grid-column: 2;
    }
    .reading-notes .rail-inner {
      position: static;
      max-height: none;
      margin-top: 2.5rem;
      padding: 1.5rem 0;
      border-top: 1px solid var(--c-line);
      overflow: visible;
    }
    .legend ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 960px) {
    .body,
    .after {
      grid-template-columns: minmax(0, 1fr);
    }
    .after > *,
    .reading-notes {
      grid-column: 1;
    }
    .rail {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .head {
      gap: 1.5rem;
      padding-top: calc(var(--header-h) + 2rem);
    }
    .frame,
    .next-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .meta {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .terms {
      grid-template-columns: minmax(0, 1fr);
    }
  }

</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-progress]');
  const prose = document.querySelector<HTMLElement>('[data-prose]');
  if (bar && prose) {
    let ticking = false;
    const update = () => {
      const rect = prose.getBoundingClientRect();
      const total = rect.height - window.innerHeight * 0.6;
      const p = Math.min(1, Math.max(0, -rect.top / Math.max(1, total)));
      bar.style.setProperty('--p', p.toFixed(4));
      ticking = false;
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    update();
  }

  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
  if (links.length) {
    const targets = links
      .map((l) => document.getElementById(l.dataset.tocLink!))
      .filter((el): el is HTMLElement => Boolean(el));
    let pending = false;
    const spy = () => {
      pending = false;
      const line = window.innerHeight * 0.3;
      let current = targets[0]?.id;
      for (const t of targets) if (t.getBoundingClientRect().top <= line) current = t.id;
      links.forEach((l) => l.classList.toggle('is-active', l.dataset.tocLink === current));
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!pending) {
          pending = true;
          requestAnimationFrame(spy);
        }
      },
      { passive: true },
    );
    spy();
  }
</script>
