---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import QuestionRow from '../../components/QuestionRow.astro';
import Icon, { type IconName } from '../../components/Icon.astro';

const questions = (await getCollection('questions')).sort(
  (a, b) => Number(b.data.state === 'open') - Number(a.data.state === 'open'),
);

const flow: { icon: IconName; t: string; d: string }[] = [
  { icon: 'pen', t: '提交', d: '选择观点、匿名案例或反例，无需注册，也不需要填写姓名或邮箱。' },
  { icon: 'shield', t: '审核', d: '投稿先进入待审核状态，由作者人工审核，避免可识别信息和无关内容。' },
  { icon: 'message', t: '公开与回应', d: '审核通过后公开展示，并与实验室观点清楚区分；必要时附上回应。' },
];
---

<BaseLayout title="研究讨论" description="围绕预设研究问题提交观点或匿名案例；审核后公开展示和回应。">
  <PageHero
    eyebrow="研究讨论 · Questions"
    title={'我们还不知道答案，\n所以想听你的观察。'}
    lead="每个研究问题都来自一课内容。你可以提交观点、匿名案例或反例；审核后，它们会与实验室观点分开展示。"
    accent="orange"
  />

  <section class="container">
    <ol class="flow" role="list">
      {
        flow.map((f, i) => (
          <li data-reveal style={`--i:${i}`}>
            <span class="ic">
              <Icon name={f.icon} size={20} />
            </span>
            <span class="mono n">0{i + 1}</span>
            <h2 class="t">{f.t}</h2>
            <p>{f.d}</p>
          </li>
        ))
      }
    </ol>

    <ol role="list" class="list">
      {questions.map((q, i) => <QuestionRow question={q} index={i} />)}
    </ol>
  </section>
</BaseLayout>

<style>
  .flow {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    margin: 0 0 clamp(3rem, 2rem + 4vw, 5rem);
    overflow: hidden;
    border-radius: var(--r-xl);
    background: var(--c-line);
    box-shadow: 0 0 0 1px var(--c-line);
  }

  .flow li {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas:
      'ic n'
      't t'
      'p p';
    align-items: center;
    gap: 0.75rem 1rem;
    padding: 1.75rem;
    background: var(--c-bg);
  }

  .ic {
    grid-area: ic;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 13px;
    background: var(--c-orange-soft);
    color: var(--c-orange-ink);
  }

  .n {
    grid-area: n;
    justify-self: end;
    font-size: 0.75rem;
    color: var(--c-ink-4);
  }

  .t {
    grid-area: t;
    margin-top: 0.5rem;
    font-family: var(--f-display);
    font-weight: 600;
    font-size: 1.25rem;
  }

  .flow p {
    grid-area: p;
    font-size: 0.875rem;
    line-height: 1.75;
    color: var(--c-ink-3);
  }

  .list {
    margin: 0;
  }

  @media (max-width: 820px) {
    .flow {
      grid-template-columns: 1fr;
    }
  }
</style>
