---
import BaseLayout from '../layouts/BaseLayout.astro';
import Arrow from '../components/Arrow.astro';
---

<BaseLayout title="页面不存在" footer={false}>
  <section class="nf container">
    <p class="code figure" aria-hidden="true">404</p>
    <h1 class="h1">这一页还没有被写出来。</h1>
    <p class="lead">也许它还在筹备中，也许链接有误。你可以从学习路径重新出发。</p>
    <div class="acts">
      <a class="btn" href="/learn">回到学习路径 <Arrow /></a>
      <a class="btn btn-ghost" href="/">首页</a>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    display: grid;
    place-items: center;
    align-content: center;
    gap: 1.25rem;
    min-height: 100svh;
    text-align: center;
  }

  .code {
    font-size: clamp(6rem, 4rem + 10vw, 12rem);
    font-weight: 200;
    line-height: 1;
    letter-spacing: -0.06em;
    background: linear-gradient(120deg, var(--c-blue), var(--c-violet) 50%, var(--c-teal));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: float 6s ease-in-out infinite;
  }

  @keyframes float {
    50% {
      transform: translateY(-10px);
    }
  }

  .lead {
    max-width: 30rem;
  }

  .acts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }
</style>
