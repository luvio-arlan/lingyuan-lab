---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Logo from '../components/Logo.astro';
import { Image } from 'astro:assets';
import founderPortrait from '../assets/people/cai-lu.png';
import { author, evidenceTypes, site } from '../data/site';

const standards = [
  '写出具体研究问题、场景与适用边界。',
  '定义关键术语，区分 OD、组织设计、工作设计，以及 AI 工具、Agent 等概念。',
  '关键事实附原始来源：作者、标题、年份、版本、链接或 DOI、访问日期。',
  '为段落或结论标注「研究证据 / 案例观察 / 作者推论 / 待验证假设」。经典理论不等于对当代 AI 组织效果的实证证明。',
  '列出至少一个竞争性解释或反例，以及尚未解决的问题。',
  '由人逐条核对 AI 辅助整理出的事实、引文和数据；不发布查不到原文的引用。',
  '每次实质修订记录日期与变化；涉及企业实践时先获得授权并匿名化。',
];

const readers = [
  { t: '正在学习或实践 OD、HR、组织设计的人', d: '需要一条循序的学习路径，以及能带回工作中的分析工具。' },
  { t: '关心人机协作的业务负责人', d: '想知道 AI 进入团队后，哪些安排需要重新设计。' },
  { t: 'AI 产品实践者', d: '想理解组织层面的约束，而不只是单个任务的效率。' },
];
---

<BaseLayout title="关于" description="灵鸢实验室的项目定位、研究方法与写作标准。">
  <PageHero
    eyebrow="关于 · About"
    title={'一间开放的\n研究工作室。'}
    lead={site.description}
    en={site.descriptionEn}
    accent="blue"
  />

  <section class="container sec brand" data-reveal>
    <div class="logo-card card">
      <Logo height={140} />
    </div>
    <div class="brand-copy">
      <h2 class="h2">Lingyuan Lab · 灵鸢实验室</h2>
      <p>
        “AI 原生组织”在这里是一个研究问题，而不是预设的标准答案。我们从组织发展（OD）的经典知识出发，研究 AI
        如何改变任务、协作、决策、组织设计与人才系统，并邀请读者讨论这些做法可能出现的形态及其边界。
      </p>
    </div>
  </section>

  <section class="container sec" aria-labelledby="readers-title">
    <h2 class="h2 sec-title" id="readers-title" data-reveal>写给谁</h2>
    <div class="readers">
      {
        readers.map((r, i) => (
          <div class="card reader" data-reveal style={`--i:${i}`}>
            <span class="mono n">0{i + 1}</span>
            <h3 class="h3">{r.t}</h3>
            <p>{r.d}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="container sec" aria-labelledby="evidence-title">
    <h2 class="h2 sec-title" id="evidence-title" data-reveal>四种证据状态</h2>
    <div class="ev-grid">
      {
        Object.values(evidenceTypes).map((t, i) => (
          <div class="card ev" data-accent={t.accent} data-reveal style={`--i:${i}`}>
            <span class="bar" />
            <h3 class="h3">{t.label}</h3>
            <p class="en">{t.en}</p>
            <p class="note">{t.note}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="container sec split" aria-labelledby="std-title">
    <div>
      <h2 class="h2 sec-title" id="std-title" data-reveal>每篇文章的发布标准</h2>
      <p class="muted" data-reveal style="--i:1">在一篇文章被标记为“已核对发布”之前，它需要满足以下七条标准。</p>
    </div>
    <ol class="std" role="list">
      {
        standards.map((s, i) => (
          <li data-reveal style={`--i:${i % 4}`}>
            <span class="mono">{String(i + 1).padStart(2, '0')}</span>
            <p>{s}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="container sec split founder" aria-labelledby="author-title">
    <div>
      <h2 class="h2 sec-title" id="author-title" data-reveal>关于创始人</h2>
      <Image
        class="founder-portrait"
        src={founderPortrait}
        alt={`${author.name}（${author.alias}），灵鸢实验室创始人`}
        widths={[280, 560]}
        sizes="(max-width: 520px) 240px, 280px"
        width={280}
        height={280}
        format="webp"
        loading="lazy"
        decoding="async"
      />
    </div>
    <div class="license" data-reveal style="--i:1">
      <h3 class="h3">{author.name} · {author.alias}</h3>
      <p class="founder-role">{author.role}</p>
      <p class="founder-lead">我关心的是：当 AI 成为工作的参与者，人如何协作，组织如何重新找到自己的秩序。</p>
      <p>我毕业于吉林大学，拥有软件工程与金融学双学位背景。曾在阿里云从事组织发展与 AI 产品实践，参与 OKR 智能化、动态角色与职责、人才培养及运营工具建设。这些经历，让我的关注始终落在具体的工作现场：一项任务如何交出去，一个决定由谁来做，一群人怎样把事情做成。</p>
      <p>我的实践连接组织发展与产品开发：把组织问题转化为产品需求，通过跨团队协作、AI Agent 设计与开发，推进从场景分析到上线验收的完整过程。我希望研究中的概念，最终能成为人们理解工作、改善协作的工具。</p>
      <p>因此，我创建了灵鸢实验室。这是我的独立学习与研究项目，也是一个持续提出问题、验证想法的地方。我把实践中的困惑带回理论，再把理论带回真实场景；期待和同样好奇的人一起，慢慢看清 AI 与组织之间正在发生的变化。</p>
      <p class="founder-note">本站观点以个人研究与实践为基础，不代表任何任职或曾任职机构。</p>
      <p>研究交流、内容纠错或合作提议，欢迎联系：<a href={`mailto:${author.email}`}>{author.email}</a>。</p>
    </div>
  </section>

  <section class="container sec split" aria-labelledby="license-title">
    <h2 class="h2 sec-title" id="license-title" data-reveal>许可与署名</h2>
    <div class="license" data-reveal style="--i:1">
      <p>本站原创文字内容采用 <strong>CC BY 4.0</strong> 署名许可。转载或改编时，请注明作者、原文链接、许可链接，并说明修改情况。</p>
      <p>品牌名称与标志、第三方资料、源码及读者投稿有各自的权利边界。请阅读<a href="/license">完整的许可与署名说明</a>。</p>
    </div>
  </section>
</BaseLayout>

<style>
  .sec {
    padding-block: clamp(3rem, 2rem + 3vw, 5rem);
  }

  .sec-title {
    margin-bottom: 2rem;
  }

  .brand {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: center;
  }

  .logo-card {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    border-radius: var(--r-xl);
    background:
      radial-gradient(60% 60% at 50% 50%, var(--c-bg), var(--c-mist) 100%);
  }

  .logo-card :global(.logo) {
    width: min(78%, 420px);
    height: auto;
  }

  .brand-copy {
    display: grid;
    gap: 1.25rem;
  }

  .brand-copy p {
    color: var(--c-ink-2);
    line-height: 1.95;
    font-size: 1.0625rem;
  }

  .readers {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .reader {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    padding: 1.75rem;
  }

  .reader .n {
    font-size: 0.75rem;
    color: var(--c-blue-ink);
  }

  .reader p {
    color: var(--c-ink-3);
    font-size: 0.9375rem;
    line-height: 1.75;
  }

  .ev-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }

  .ev {
    display: grid;
    align-content: start;
    gap: 0.4rem;
    padding: 1.5rem;
    overflow: hidden;
  }

  .ev .bar {
    width: 28px;
    height: 4px;
    margin-bottom: 0.75rem;
    border-radius: 4px;
    background: var(--a);
  }

  .ev .en {
    color: var(--c-ink-3);
  }

  .ev .note {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    line-height: 1.75;
    color: var(--c-ink-2);
  }

  .split {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    border-top: 1px solid var(--c-line-2);
  }

  .std {
    display: grid;
    margin: 0;
  }

  .std li {
    display: flex;
    gap: 1.25rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--c-line);
    line-height: 1.8;
    color: var(--c-ink-2);
  }

  .std li:first-child {
    padding-top: 0;
  }

  .std .mono {
    padding-top: 0.2rem;
    font-size: 0.75rem;
    color: var(--c-blue-ink);
  }

  .license {
    display: grid;
    gap: 1rem;
    line-height: 1.9;
    color: var(--c-ink-2);
  }

  .founder-portrait {
    display: block;
    width: min(100%, 280px);
    height: auto;
    aspect-ratio: 1;
    margin-top: 2rem;
    border-radius: var(--r-xl);
  }

  .founder {
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
  }

  .founder .license {
    max-width: 46rem;
  }

  .founder-role,
  .founder-note {
    color: var(--c-ink-3);
    font-size: 0.9375rem;
  }

  .founder-lead {
    font-family: var(--f-display);
    font-size: clamp(1.25rem, 1.1rem + 0.5vw, 1.5rem);
    color: var(--c-ink);
    line-height: 1.7;
    margin-block: 0.5rem;
  }

  @media (max-width: 960px) {
    .brand,
    .split {
      grid-template-columns: 1fr;
    }
    .readers {
      grid-template-columns: 1fr;
    }
    .ev-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .founder-portrait {
      width: min(100%, 240px);
    }
    .ev-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
