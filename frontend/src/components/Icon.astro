  check: '<path d="M20 6 9 17l-5-5"/>',
  copy: '<rect width="13" height="13" x="8.5" y="8.5" rx="2.5"/><path d="M4.5 15.5c-1.1 0-2-.9-2-2v-9c0-1.1.9-2 2-2h9c1.1 0 2 .9 2 2"/>',
  printer:
