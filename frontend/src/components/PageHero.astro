---
import type { Accent } from '../data/site';

interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  accent?: Accent;
  en?: string;
}

const { eyebrow, title, lead, accent = 'blue', en } = Astro.props;
const lines = title.split('\n');
---

<section class="page-hero" data-accent={accent}>
  <div class="bg" aria-hidden="true">
    <div class="glow"></div>
    <div class="dots"></div>
  </div>
  <div class="container inner">
    <p class="eyebrow hero-in" style="--d:0">{eyebrow}</p>
    <h1 class="display">
      {
        lines.map((line, i) => (
          <span class="line">
            <span style={`--d:${i + 1}`}>{line}</span>
          </span>
        ))
      }
    </h1>
    {en && <p class="en-sub en hero-in" style={`--d:${lines.length + 1}`}>{en}</p>}
    {lead && <p class="lead hero-in" style={`--d:${lines.length + 2}`}>{lead}</p>}
    <div class="extra hero-in" style={`--d:${lines.length + 3}`}>
      <slot />
    </div>
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    padding: calc(var(--header-h) + clamp(4rem, 3rem + 6vw, 8rem)) 0 clamp(3.5rem, 2.5rem + 4vw, 6rem);
    overflow: clip;
  }

  .bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .glow {
    position: absolute;
    top: -30%;
    right: -10%;
    width: 60vmax;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--a) 14%, transparent), transparent 62%);
    filter: blur(40px);
    animation: glow-in 2s var(--ease-out) both;
  }

  .dots {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgb(11 18 32 / 0.07) 1px, transparent 1px);
    background-size: 24px 24px;
    mask-image: radial-gradient(ellipse 60% 80% at 80% 20%, #000, transparent 70%);
  }

  @keyframes glow-in {
    from {
      opacity: 0;
      transform: scale(0.8);
    }
  }

  .inner {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }

  .display {
    max-width: 16em;
  }

  .line {
    display: block;
    overflow: clip;
    padding-bottom: 0.06em;
  }

  .line > span {
    display: inline-block;
    animation: up 1.1s calc(var(--d) * 90ms + 80ms) var(--ease-out) both;
  }

  .hero-in {
    animation: fade-up 1s calc(var(--d) * 90ms + 160ms) var(--ease-out) both;
  }

  .en-sub {
    margin-top: -0.5rem;
    font-size: clamp(1.25rem, 1rem + 0.8vw, 1.75rem);
    color: var(--c-ink-4);
  }

  .lead {
    max-width: 40rem;
  }

  .extra:empty {
    display: none;
  }

  @keyframes up {
    from {
      transform: translateY(105%);
    }
  }

  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(14px);
      filter: blur(4px);
    }
  }
</style>
