---
interface Props {
  label?: string;
}

const { label = '本节要点' } = Astro.props;
---

<aside class="key-idea" data-reveal>
  <p class="label mono">{label}</p>
  <div class="text"><slot /></div>
</aside>

<style>
  .key-idea {
    position: relative;
    margin: 2.5em 0;
    padding: 1.75rem 1.75rem 1.75rem 2rem;
    border-radius: var(--r-lg);
    background:
      radial-gradient(120% 140% at 0% 0%, var(--c-blue-soft), transparent 60%),
      var(--c-mist);
    box-shadow: 0 0 0 1px var(--c-line) inset;
    overflow: hidden;
  }

  .label {
    margin-bottom: 0.6rem;
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    color: var(--c-blue-ink);
  }

  .text {
    font-family: var(--f-display);
    font-size: 1.3125rem;
    font-weight: 500;
    line-height: 1.65;
    color: var(--c-ink);
  }

  .text :global(p) {
    margin: 0;
  }
</style>
