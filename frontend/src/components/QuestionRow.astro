---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { lessonBySlug } from '../data/path';

interface Props {
  question: CollectionEntry<'questions'>;
  index: number;
}

const { question, index } = Astro.props;
const { data } = question;
const lesson = data.lesson ? lessonBySlug(data.lesson) : undefined;
const open = data.state === 'open';
---

<li class="q-row" data-accent={data.accent} data-reveal style={`--i:${index}`}>
  <a href={`/questions/${question.id}`} class:list={['q-link', { planned: !open }]}>
    <span class="idx mono">Q{String(index + 1).padStart(2, '0')}</span>
    <span class="main">
      <span class="title" style={`view-transition-name: q-${question.id}`}>{data.title}</span>
      <span class="summary">{data.summary}</span>
    </span>
    <span class="side">
      <span class:list={['chip', !open && 'chip-outline']}>
        {open && <span class="dot pulse" />}
        {open ? '征集观点中' : '即将开放'}
      </span>
      {lesson && <span class="mono lesson">第 {lesson.no} 课</span>}
    </span>
    <span class="arrow-btn" aria-hidden="true"><Icon name="arrow-right" size={18} /></span>
  </a>
</li>

<style>
  .q-row {
    border-top: 1px solid var(--c-line-2);
  }

  .q-row:last-child {
    border-bottom: 1px solid var(--c-line-2);
  }

  .q-link {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr) auto 44px;
    align-items: center;
    gap: 1.5rem;
    padding: 2rem 1rem;
    margin-inline: -1rem;
    border-radius: var(--r-md);
  }

  .q-link::before {
    content: '';
    position: absolute;
    inset: 4px 0;
    z-index: -1;
    border-radius: var(--r-md);
    background: linear-gradient(90deg, var(--a-soft), color-mix(in srgb, var(--a-soft) 30%, transparent));
    transform: scaleX(0.96);
    opacity: 0;
    transition:
      opacity 400ms var(--ease-out),
      transform 600ms var(--ease-out);
  }

  .q-link:hover::before {
    opacity: 1;
    transform: none;
  }

  .idx {
    align-self: start;
    padding-top: 0.45rem;
    font-size: 0.75rem;
    color: var(--a-ink);
  }

  .main {
    display: grid;
    gap: 0.5rem;
  }

  .title {
    font-family: var(--f-display);
    font-weight: 500;
    font-size: clamp(1.25rem, 1.05rem + 0.8vw, 1.75rem);
    line-height: 1.45;
    color: var(--c-ink);
    text-wrap: balance;
    transition: transform 600ms var(--ease-out);
  }

  .q-link:hover .title {
    transform: translateX(6px);
  }

  .summary {
    color: var(--c-ink-3);
    font-size: 0.9375rem;
    line-height: 1.75;
    max-width: 44rem;
  }

  .planned .title {
    color: var(--c-ink-2);
  }

  .side {
    display: grid;
    justify-items: end;
    gap: 0.5rem;
  }

  .lesson {
    font-size: 0.75rem;
    color: var(--c-ink-4);
  }

  .pulse {
    animation: blink 2s var(--ease-in-out) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0.3;
    }
  }

  .arrow-btn {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    box-shadow: 0 0 0 1px var(--c-line-2) inset;
    color: var(--c-ink-2);
    transition:
      background-color 300ms var(--ease-out),
      color 300ms var(--ease-out),
      transform 500ms var(--ease-spring);
  }

  .q-link:hover .arrow-btn {
    background: var(--c-ink);
    color: #fff;
    transform: translateX(4px);
  }

  @media (max-width: 760px) {
    .q-link {
      grid-template-columns: 1fr;
      gap: 0.9rem;
      padding: 1.5rem 1rem;
    }
    .idx {
      padding: 0;
    }
    .side {
      justify-items: start;
      grid-auto-flow: column;
      justify-content: start;
      align-items: center;
    }
    .arrow-btn {
      display: none;
    }
  }
</style>
