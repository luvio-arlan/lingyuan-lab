---
const layers = [
  {
    "id": "work",
    "label": "明确工作要求",
    "en": "Work",
    "accent": "orange",
    "text": "从实际决定与异常出发，写出要判断什么、承担什么责任。会使用工具、能独立检查依据和能正确升级，是不同要求。"
  },
  {
    "id": "practice",
    "label": "安排练习与反馈",
    "en": "Practice",
    "accent": "teal",
    "text": "让新人先判断，再用工具比较，在导师反馈下处理有边界的例外。导师需要时间；练习不能以真实客户风险换取学习。"
  },
  {
    "id": "evidence",
    "label": "收集能力证据",
    "en": "Evidence",
    "accent": "violet",
    "text": "分别记录有工具的交付表现、对新案例的解释和异常识别；匹配任务难度与条件。工具辅助表现不能直接替代能力结论。"
  },
  {
    "id": "reward",
    "label": "调整评价与资源",
    "en": "Evaluate",
    "accent": "orange",
    "text": "把复核、知识维护与带教计入容量和贡献，允许纠错与合理求助。若量表鼓励隐瞒错误或导师负荷过高，先改资源与指标再继续。"
  }
] as const;
---

<figure class="changes" id="diagram" data-talent>
  <div class="stack" role="group" aria-label="能力、培养与评价的反馈循环">
    {
      layers.map((layer) => (
        <button type="button" data-layer={layer.id} data-accent={layer.accent} aria-pressed="false">
          <span class="lbl">{layer.label}</span>
          <span class="en">{layer.en}</span>
        </button>
      ))
    }
  </div>
  <div class="panel" aria-live="polite">
    <p data-text="default">工作要求 → 练习与反馈 → 能力证据 → 评价与资源 → 回到工作要求。选择节点，检查培养和评价是否互相支持。</p>
    {
      layers.map((layer) => (
        <p data-text={layer.id} data-accent={layer.accent} hidden>
          <strong>{layer.label}</strong>
          {layer.text}
        </p>
      ))
    }
  </div>
  <figcaption>图 · 能力、培养与评价的反馈循环（本站教学图解，非经过验证的量表）。</figcaption>
</figure>

<style>
  .changes {
    margin: 2.75em 0;
    padding: clamp(1rem, 0.5rem + 2vw, 2rem);
    border-radius: var(--r-xl);
    background:
      radial-gradient(120% 80% at 100% 0%, var(--c-mist), transparent 55%),
      var(--c-bg);
    box-shadow: var(--shadow-1);
  }

  .stack {
    display: grid;
    gap: 0.75rem;
    max-width: 28rem;
    margin-inline: auto;
  }

  button {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.75rem;
    width: 100%;
    padding: 0.9rem 1rem;
    border: 1px solid var(--c-line-2);
    border-radius: var(--r-md);
    background: var(--c-bg);
    color: var(--c-ink);
    text-align: left;
    cursor: pointer;
  }

  button:hover,
  button:focus-visible {
    border-color: var(--a);
  }

  button[aria-pressed='true'] {
    background: var(--a-soft);
    border-color: transparent;
    box-shadow: 0 0 0 1px var(--a);
  }

  .lbl {
    font-family: var(--f-display);
    font-size: 1.35rem;
    font-weight: 500;
    line-height: 1.2;
  }

  .en {
    color: var(--c-ink-3);
    font-size: 0.8125rem;
  }

  .panel {
    max-width: 34rem;
    min-height: 4.5em;
    margin: 1.5rem auto 0;
    text-align: center;
    color: var(--c-ink-2);
    line-height: 1.85;
  }

  .panel p {
    animation: in 500ms var(--ease-out);
  }

  .panel strong {
    margin-right: 0.5em;
    color: var(--a-ink);
  }

  @keyframes in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .panel p {
      animation: none;
    }
  }

  figcaption {
    margin-top: 1rem;
    text-align: center;
    font-size: 0.8125rem;
    color: var(--c-ink-3);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-talent]').forEach((root) => {
    const buttons = root.querySelectorAll<HTMLButtonElement>('[data-layer]');
    const texts = root.querySelectorAll<HTMLElement>('[data-text]');
    const select = (id: string | null) => {
      buttons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.layer === id)));
      texts.forEach((text) => (text.hidden = text.dataset.text !== (id ?? 'default')));
    };
    buttons.forEach((button) =>
      button.addEventListener('click', () =>
        select(button.getAttribute('aria-pressed') === 'true' ? null : button.dataset.layer!),
      ),
    );
  });
</script>
