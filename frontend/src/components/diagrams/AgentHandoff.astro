---
const layers = [
  {
    "id": "delegate",
    "label": "约定与授权",
    "en": "Delegate",
    "accent": "violet",
    "text": "委派者写明目标、输入、允许动作和完成标准；系统仅开放对应权限。边界不清楚时不开始执行。"
  },
  {
    "id": "execute",
    "label": "执行与留证",
    "en": "Execute",
    "accent": "violet",
    "text": "Agent 在许可范围内执行，保存输入出处、变更与操作记录。缺数据、依据冲突或越界时停下，不能靠猜测补齐。"
  },
  {
    "id": "review",
    "label": "复核与退回",
    "en": "Review",
    "accent": "teal",
    "text": "复核者检查依据与拟执行动作，并有时间、访问权和退回权。未满足标准回到补证，不直接放行。"
  },
  {
    "id": "release",
    "label": "放行与观察",
    "en": "Release",
    "accent": "teal",
    "text": "有权角色批准约定范围内的执行，观察实际后果。放行不扩大原授权，也不终止纠正责任。"
  },
  {
    "id": "escalate",
    "label": "暂停与接手",
    "en": "Escalate",
    "accent": "orange",
    "text": "从任一步转入：打包已做、未做、冲突和待决定事项，交指定角色；超时找备用角色，无人接手保持暂停。恢复由有权者决定。"
  }
] as const;
---

<figure class="changes" id="diagram" data-handoff>
  <div class="stack" role="group" aria-label="委派、复核与异常接手">
    {
      layers.map((layer) => (
        <button type="button" data-layer={layer.id} data-accent={layer.accent} aria-pressed="false">
          <span class="lbl">{layer.label}</span>
          <span class="en">{layer.en}</span>
        </button>
      ))
    }
  </div>
  <div class="panel" aria-live="polite">
    <p data-text="default">按顺序查看委派 → 执行 → 复核 → 放行；任一步达到异常条件，就停止相关动作并转交接手。选择节点查看条件。</p>
    {
      layers.map((layer) => (
        <p data-text={layer.id} data-accent={layer.accent} hidden>
          <strong>{layer.label}</strong>
          {layer.text}
        </p>
      ))
    }
  </div>
  <figcaption>图 · 委派、复核与异常接手（本站教学图解，非经过验证的量表）。</figcaption>
</figure>

<style>
  .changes {
    margin: 2.75em 0;
    padding: clamp(1rem, 0.5rem + 2vw, 2rem);
    border-radius: var(--r-xl);
    background:
      radial-gradient(120% 80% at 100% 0%, var(--c-mist), transparent 55%),
      var(--c-bg);
    box-shadow: var(--shadow-1);
  }

  .stack {
    display: grid;
    gap: 0.75rem;
    max-width: 28rem;
    margin-inline: auto;
  }

  button {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.75rem;
    width: 100%;
    padding: 0.9rem 1rem;
    border: 1px solid var(--c-line-2);
    border-radius: var(--r-md);
    background: var(--c-bg);
    color: var(--c-ink);
    text-align: left;
    cursor: pointer;
  }

  button:hover,
  button:focus-visible {
    border-color: var(--a);
  }

  button[aria-pressed='true'] {
    background: var(--a-soft);
    border-color: transparent;
    box-shadow: 0 0 0 1px var(--a);
  }

  .lbl {
    font-family: var(--f-display);
    font-size: 1.35rem;
    font-weight: 500;
    line-height: 1.2;
  }

  .en {
    color: var(--c-ink-3);
    font-size: 0.8125rem;
  }

  .panel {
    max-width: 34rem;
    min-height: 4.5em;
    margin: 1.5rem auto 0;
    text-align: center;
    color: var(--c-ink-2);
    line-height: 1.85;
  }

  .panel p {
    animation: in 500ms var(--ease-out);
  }

  .panel strong {
    margin-right: 0.5em;
    color: var(--a-ink);
  }

  @keyframes in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .panel p {
      animation: none;
    }
  }

  figcaption {
    margin-top: 1rem;
    text-align: center;
    font-size: 0.8125rem;
    color: var(--c-ink-3);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-handoff]').forEach((root) => {
    const buttons = root.querySelectorAll<HTMLButtonElement>('[data-layer]');
    const texts = root.querySelectorAll<HTMLElement>('[data-text]');
    const select = (id: string | null) => {
      buttons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.layer === id)));
      texts.forEach((text) => (text.hidden = text.dataset.text !== (id ?? 'default')));
    };
    buttons.forEach((button) =>
      button.addEventListener('click', () =>
        select(button.getAttribute('aria-pressed') === 'true' ? null : button.dataset.layer!),
      ),
    );
  });
</script>
