---
const layers = [
  {
    "id": "frame",
    "label": "定义问题",
    "en": "Frame",
    "accent": "violet",
    "text": "谁确认目标、约束和权重？采购示意中先明确交期与维护的取舍，Agent 不能自行修改评价规则。"
  },
  {
    "id": "options",
    "label": "形成选项",
    "en": "Options",
    "accent": "violet",
    "text": "谁决定候选范围并检查遗漏？把过滤规则、原始资料与合理备选一起交出，避免只提供排名。"
  },
  {
    "id": "approve",
    "label": "批准取舍",
    "en": "Approve",
    "accent": "teal",
    "text": "谁正式批准，谁实际上最影响选择？批准者需要时间、依据与退回权；关键前提不成立时返回问题定义。"
  },
  {
    "id": "correct",
    "label": "执行与纠正",
    "en": "Correct",
    "accent": "orange",
    "text": "谁下单、暂停、撤回和受理异议？执行必须符合已批准内容；新证据出现时重新打开决定，而非机械沿用排名。"
  }
] as const;
---

<figure class="changes" id="diagram" data-rights>
  <div class="stack" role="group" aria-label="决定权与信息的四个位置">
    {
      layers.map((layer) => (
        <button type="button" data-layer={layer.id} data-accent={layer.accent} aria-pressed="false">
          <span class="lbl">{layer.label}</span>
          <span class="en">{layer.en}</span>
        </button>
      ))
    }
  </div>
  <div class="panel" aria-live="polite">
    <p data-text="default">问题定义 → 选项形成 → 批准取舍 → 执行纠正；每一处都可能退回前一步。选择节点，追踪权利和证据。</p>
    {
      layers.map((layer) => (
        <p data-text={layer.id} data-accent={layer.accent} hidden>
          <strong>{layer.label}</strong>
          {layer.text}
        </p>
      ))
    }
  </div>
  <figcaption>图 · 决定权与信息的四个位置（本站教学图解，非经过验证的量表）。</figcaption>
</figure>

<style>
  .changes {
    margin: 2.75em 0;
    padding: clamp(1rem, 0.5rem + 2vw, 2rem);
    border-radius: var(--r-xl);
    background:
      radial-gradient(120% 80% at 100% 0%, var(--c-mist), transparent 55%),
      var(--c-bg);
    box-shadow: var(--shadow-1);
  }

  .stack {
    display: grid;
    gap: 0.75rem;
    max-width: 28rem;
    margin-inline: auto;
  }

  button {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.75rem;
    width: 100%;
    padding: 0.9rem 1rem;
    border: 1px solid var(--c-line-2);
    border-radius: var(--r-md);
    background: var(--c-bg);
    color: var(--c-ink);
    text-align: left;
    cursor: pointer;
  }

  button:hover,
  button:focus-visible {
    border-color: var(--a);
  }

  button[aria-pressed='true'] {
    background: var(--a-soft);
    border-color: transparent;
    box-shadow: 0 0 0 1px var(--a);
  }

  .lbl {
    font-family: var(--f-display);
    font-size: 1.35rem;
    font-weight: 500;
    line-height: 1.2;
  }

  .en {
    color: var(--c-ink-3);
    font-size: 0.8125rem;
  }

  .panel {
    max-width: 34rem;
    min-height: 4.5em;
    margin: 1.5rem auto 0;
    text-align: center;
    color: var(--c-ink-2);
    line-height: 1.85;
  }

  .panel p {
    animation: in 500ms var(--ease-out);
  }

  .panel strong {
    margin-right: 0.5em;
    color: var(--a-ink);
  }

  @keyframes in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .panel p {
      animation: none;
    }
  }

  figcaption {
    margin-top: 1rem;
    text-align: center;
    font-size: 0.8125rem;
    color: var(--c-ink-3);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-rights]').forEach((root) => {
    const buttons = root.querySelectorAll<HTMLButtonElement>('[data-layer]');
    const texts = root.querySelectorAll<HTMLElement>('[data-text]');
    const select = (id: string | null) => {
      buttons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.layer === id)));
      texts.forEach((text) => (text.hidden = text.dataset.text !== (id ?? 'default')));
    };
    buttons.forEach((button) =>
      button.addEventListener('click', () =>
        select(button.getAttribute('aria-pressed') === 'true' ? null : button.dataset.layer!),
      ),
    );
  });
</script>
