---
const layers = [
  {
    "id": "depend",
    "label": "找出依赖",
    "en": "Dependencies",
    "accent": "orange",
    "text": "记录共享资源、上下游交接与必须共同判断的事项。一次提案表现不能代表实施、维护和长期责任。"
  },
  {
    "id": "team",
    "label": "完整交付小组",
    "en": "End-to-end team",
    "accent": "teal",
    "text": "假设：共享现场信息多时，小组负责从需求到验收可减少交接。需配数据、权限和专家支持。反例：隐蔽专业约束或规则重复维护。"
  },
  {
    "id": "shared",
    "label": "共享专业支持",
    "en": "Shared expertise",
    "accent": "violet",
    "text": "假设：重复专业检查可共享，业务组保留情境判断。需保障接单容量与响应。反例：高度现场化问题反复讲背景，形成新瓶颈。"
  },
  {
    "id": "compare",
    "label": "试点与退出",
    "en": "Compare",
    "accent": "orange",
    "text": "同类任务比较质量、等待、总投入和成员负荷，把知识维护与复核纳入岗位。专业漏错或排队恶化时停止；不要以人数更少证明成功。"
  }
] as const;
---

<figure class="changes" id="diagram" data-choices>
  <div class="stack" role="group" aria-label="两种团队设计假设及反例">
    {
      layers.map((layer) => (
        <button type="button" data-layer={layer.id} data-accent={layer.accent} aria-pressed="false">
          <span class="lbl">{layer.label}</span>
          <span class="en">{layer.en}</span>
        </button>
      ))
    }
  </div>
  <div class="panel" aria-live="polite">
    <p data-text="default">先找共同依赖，再比较两种安排。节点并非连续步骤；同一类工作可以保留现状，也可以组合两种方案。</p>
    {
      layers.map((layer) => (
        <p data-text={layer.id} data-accent={layer.accent} hidden>
          <strong>{layer.label}</strong>
          {layer.text}
        </p>
      ))
    }
  </div>
  <figcaption>图 · 两种团队设计假设及反例（本站教学图解，非经过验证的量表）。</figcaption>
</figure>

<style>
  .changes {
    margin: 2.75em 0;
    padding: clamp(1rem, 0.5rem + 2vw, 2rem);
    border-radius: var(--r-xl);
    background:
      radial-gradient(120% 80% at 100% 0%, var(--c-mist), transparent 55%),
      var(--c-bg);
    box-shadow: var(--shadow-1);
  }

  .stack {
    display: grid;
    gap: 0.75rem;
    max-width: 28rem;
    margin-inline: auto;
  }

  button {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.75rem;
    width: 100%;
    padding: 0.9rem 1rem;
    border: 1px solid var(--c-line-2);
    border-radius: var(--r-md);
    background: var(--c-bg);
    color: var(--c-ink);
    text-align: left;
    cursor: pointer;
  }

  button:hover,
  button:focus-visible {
    border-color: var(--a);
  }

  button[aria-pressed='true'] {
    background: var(--a-soft);
    border-color: transparent;
    box-shadow: 0 0 0 1px var(--a);
  }

  .lbl {
    font-family: var(--f-display);
    font-size: 1.35rem;
    font-weight: 500;
    line-height: 1.2;
  }

  .en {
    color: var(--c-ink-3);
    font-size: 0.8125rem;
  }

  .panel {
    max-width: 34rem;
    min-height: 4.5em;
    margin: 1.5rem auto 0;
    text-align: center;
    color: var(--c-ink-2);
    line-height: 1.85;
  }

  .panel p {
    animation: in 500ms var(--ease-out);
  }

  .panel strong {
    margin-right: 0.5em;
    color: var(--a-ink);
  }

  @keyframes in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .panel p {
      animation: none;
    }
  }

  figcaption {
    margin-top: 1rem;
    text-align: center;
    font-size: 0.8125rem;
    color: var(--c-ink-3);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-choices]').forEach((root) => {
    const buttons = root.querySelectorAll<HTMLButtonElement>('[data-layer]');
    const texts = root.querySelectorAll<HTMLElement>('[data-text]');
    const select = (id: string | null) => {
      buttons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.layer === id)));
      texts.forEach((text) => (text.hidden = text.dataset.text !== (id ?? 'default')));
    };
    buttons.forEach((button) =>
      button.addEventListener('click', () =>
        select(button.getAttribute('aria-pressed') === 'true' ? null : button.dataset.layer!),
      ),
    );
  });
</script>
