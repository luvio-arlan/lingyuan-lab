FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy PYTHONDONTWRITEBYTECODE=1
WORKDIR /app/backend
COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY backend/src ./src
RUN uv sync --frozen --no-dev
COPY database/migrations /app/database/migrations
COPY frontend/src/content/questions /app/frontend/src/content/questions
COPY frontend/src/data/path.ts /app/frontend/src/data/path.ts
ENV PATH="/app/backend/.venv/bin:${PATH}" LINGYUAN_MIGRATIONS_DIR=/app/database/migrations
USER 10001:10001
CMD ["uvicorn", "--factory", "lingyuan_api.main:create_app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--no-proxy-headers", "--no-access-log"]
