# Copy to deploy/.env; replace every value before production deployment.
POSTGRES_PASSWORD=replace-with-random-hex
RATE_LIMIT_SALT=replace-with-random-hex
BACKUP_DIR=/var/backups/lingyuan
# On Linux, set these to the UID/GID of the backup directory owner.
# BACKUP_UID=997
# BACKUP_GID=997
WEB_PORT=8080
# Set this to the private Docker network CIDR if your host does not use 172.16.0.0/12.
# TRUSTED_PROXY_CIDR=172.16.0.0/12
